---
import { render, type CollectionEntry } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Icon from '../../../components/Icon.astro';
import MySglangExplorer from '../../../components/MySglangExplorer.astro';
import { copy } from '../../../data/site';
import { getPosts, postUrl, postSlug, formatDate, readingTime } from '../../../lib/posts';
export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { lang: post.data.lang, id: postSlug(post) }, props: { post, posts } }));
}
const { post, posts } = Astro.props as { post: CollectionEntry<'blog'>; posts: CollectionEntry<'blog'>[] };
const lang = post.data.lang;
const t = copy[lang];
const other = lang === 'en' ? 'zh' : 'en';
const translation = posts.find((entry) => entry.data.lang === other && entry.data.translationKey === post.data.translationKey);
const { Content, headings } = await render(post);
---
<Base lang={lang} title={post.data.title} description={post.data.description} active="blog" alternate={translation ? postUrl(translation) : `/${other}/blog/`} translationAvailable={Boolean(translation)} noindex={post.data.draft} articleDate={post.data.date}>
  <article class="article-shell shell">
    <a class="text-link article-back" href={`/${lang}/blog/`}><span aria-hidden="true">←</span>{t.backWriting}</a>
    <header class="article-header"><div class="post-meta"><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date, lang)}</time><span>{readingTime(post.body)} {t.minutes}</span>{post.data.draft && <span class="draft">{t.draft}</span>}</div><h1>{post.data.title}</h1><p>{post.data.description}</p><div class="post-tags">{post.data.tags.map((tag) => <span>{tag}</span>)}</div></header>
    <div class="article-grid"><div class="prose"><Content /></div>{headings.some((h) => h.depth === 2) && <aside class="article-toc"><p class="eyebrow">{t.contents}</p><nav aria-label={t.contents}>{headings.filter((h) => h.depth === 2).map((h) => <a href={`#${h.slug}`}>{h.text}</a>)}</nav></aside>}</div>
    <div class="article-end"><a class="text-link" href={`/${lang}/blog/`}>{t.allWriting}<Icon /></a><span>Cyrus</span></div>
  </article>
  {post.data.translationKey === 'my-sglang-01-architecture' && <MySglangExplorer />}
</Base>

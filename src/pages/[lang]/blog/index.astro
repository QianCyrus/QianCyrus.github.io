---
import Base from '../../../layouts/Base.astro';
import Icon from '../../../components/Icon.astro';
import EmptyWriting from '../../../components/EmptyWriting.astro';
import PostCard from '../../../components/PostCard.astro';
import { copy, languagePaths, type Language } from '../../../data/site';
import { getPosts } from '../../../lib/posts';
export const getStaticPaths = languagePaths;
const lang = Astro.params.lang as Language;
const t = copy[lang];
const posts = await getPosts(lang);
const tags = [...new Set(posts.flatMap((post) => post.data.tags))].sort();
---
<Base lang={lang} title={t.nav.blog} active="blog">
  <section class="page-heading shell"><p class="section-index">{t.blogEyebrow}</p><h1>{t.blogTitle}</h1><p>{t.blogIntro}</p></section>
  <section class="shell writing-section">
    {posts.length ? <>
      <div class="blog-controls" hidden>
        <label class="search-field"><Icon name="search" /><span class="visually-hidden">{t.search}</span><input type="search" id="post-search" placeholder={t.searchPlaceholder} autocomplete="off" /></label>
        <div class="tag-filters" role="group" aria-label={lang === 'zh' ? '按话题筛选' : 'Filter by topic'}><button data-tag="" aria-pressed="true">{t.all}</button>{tags.map((tag) => <button data-tag={tag} aria-pressed="false">{tag}</button>)}</div>
        <p class="result-count" aria-live="polite" aria-atomic="true"><span id="result-count">{posts.length}</span> {t.results}</p>
      </div>
      <div class="post-list">{posts.map((post) => <PostCard post={post} lang={lang} />)}</div>
      <div class="no-results" hidden><p>{t.noResults}</p><button class="button" id="clear-filters">{t.clear}</button></div>
    </> : <EmptyWriting lang={lang} />}
  </section>
</Base>
<script>
  const input = document.querySelector<HTMLInputElement>('#post-search');
  const cards = [...document.querySelectorAll<HTMLElement>('[data-post]')];
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-tag]')];
  const controls = document.querySelector<HTMLElement>('.blog-controls');
  if (controls) controls.hidden = false;
  let activeTag = '';
  function filterPosts() {
    const query = input?.value.trim().toLocaleLowerCase() ?? '';
    let count = 0;
    for (const card of cards) {
      const tags: string[] = JSON.parse(card.dataset.tags ?? '[]');
      const matches = (!activeTag || tags.includes(activeTag)) && (card.dataset.search ?? '').includes(query);
      card.hidden = !matches;
      if (matches) count++;
    }
    const counter = document.querySelector('#result-count');
    if (counter) counter.textContent = String(count);
    const empty = document.querySelector<HTMLElement>('.no-results');
    if (empty) empty.hidden = count !== 0;
  }
  input?.addEventListener('input', filterPosts);
  for (const button of buttons) button.addEventListener('click', () => {
    activeTag = button.dataset.tag ?? '';
    buttons.forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
    filterPosts();
  });
  document.querySelector('#clear-filters')?.addEventListener('click', () => {
    if (input) input.value = '';
    activeTag = '';
    buttons.forEach((item) => item.setAttribute('aria-pressed', String(item.dataset.tag === '')));
    filterPosts();
    input?.focus();
  });
</script>

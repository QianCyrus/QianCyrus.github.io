---
import Base from '../layouts/Base.astro';
import { copy } from '../data/site';
const t = copy.en;
---
<Base lang="en" title="404" alternate="/zh/" translationAvailable={false} noindex>
  <section class="not-found shell"><span class="error-number">404<span>✳</span></span><h1>{t.notFound}</h1><p>{t.notFoundBody}</p><div class="hero-buttons"><a class="button" href="/en/">{t.homeLink} <span aria-hidden="true">↗</span></a><a class="text-link" href="/zh/">返回中文首页 <span aria-hidden="true">→</span></a></div></section>
</Base>
